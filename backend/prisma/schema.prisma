generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserRole {
  PLAYER
  VENUE_MANAGER
  ADMIN
}

enum UserStatus {
  PENDING
  ACTIVE
  REJECTED
  SUSPENDED
}

enum SportType {
  PICKLEBALL
  SOCCER
  BADMINTON
  TENNIS
  FOOTBALL
}

enum BookingStatus {
  PENDING
  CONFIRMED
  CANCELLED
  REJECTED
  COMPLETED
}

enum MatchStatus {
  OPEN
  FULL
  CANCELLED
  COMPLETED
}

model User {
  id          String     @id @default(uuid())
  email       String     @unique
  password    String? // Nullable for OAuth users
  fullName    String     @map("full_name")
  phoneNumber String     @map("phone_number") // Bắt buộc
  role        UserRole   @default(PLAYER)
  status      UserStatus @default(ACTIVE)
  avatarUrl   String?    @map("avatar_url")
  provider    String     @default("LOCAL")
  createdAt   DateTime   @default(now()) @map("created_at")
  updatedAt   DateTime   @updatedAt @map("updated_at")

  venues           Venue[]
  bookings         Booking[]
  hostedMatches    Match[]               @relation("HostMatches")
  joinedMatches    MatchPlayer[]
  notifications    Notification[]
  reviews          Review[]              @relation("UserReviews")
  managerRequests  VenueManagerRequest[] @relation("UserRequests")
  reviewedRequests VenueManagerRequest[] @relation("ReviewedRequests")

  @@map("users")
}

model Venue {
  id          String      @id @default(uuid())
  ownerId     String      @map("owner_id")
  name        String
  address     String
  description String?
  location    Json? // GeoJSON format for mapping
  sports      SportType[]
  images      String[]
  createdAt   DateTime    @default(now()) @map("created_at")
  updatedAt   DateTime    @updatedAt @map("updated_at")

  owner   User     @relation(fields: [ownerId], references: [id])
  courts  Court[]
  reviews Review[]

  @@map("venues")
}

model Court {
  id             String    @id @default(uuid())
  venueId        String    @map("venue_id")
  name           String
  type           SportType
  pricePerHour   Decimal   @map("price_per_hour") @db.Decimal(10, 2)
  availableHours Json?     @map("available_hours")
  createdAt      DateTime  @default(now()) @map("created_at")
  updatedAt      DateTime  @updatedAt @map("updated_at")

  venue    Venue     @relation(fields: [venueId], references: [id], onDelete: Cascade)
  bookings Booking[]

  @@map("courts")
}

model Booking {
  id         String        @id @default(uuid())
  userId     String        @map("user_id")
  courtId    String        @map("court_id")
  startTime  DateTime      @map("start_time")
  endTime    DateTime      @map("end_time")
  status     BookingStatus @default(PENDING)
  totalPrice Decimal       @map("total_price") @db.Decimal(10, 2)
  createdAt  DateTime      @default(now()) @map("created_at")
  updatedAt  DateTime      @updatedAt @map("updated_at")

  user          User           @relation(fields: [userId], references: [id])
  court         Court          @relation(fields: [courtId], references: [id])
  notifications Notification[]
  review        Review?

  @@map("bookings")
}

model Notification {
  id        String   @id @default(uuid())
  userId    String   @map("user_id")
  type      String // 'BOOKING_NEW', 'BOOKING_APPROVED', 'BOOKING_REJECTED'
  bookingId String?  @map("booking_id")
  message   String
  read      Boolean  @default(false)
  createdAt DateTime @default(now()) @map("created_at")

  user    User     @relation(fields: [userId], references: [id])
  booking Booking? @relation(fields: [bookingId], references: [id])

  @@map("notifications")
}

model Review {
  id        String   @id @default(uuid())
  rating    Int // 1-5 stars
  comment   String?
  userId    String   @map("user_id")
  venueId   String   @map("venue_id")
  bookingId String   @unique @map("booking_id")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  user    User    @relation("UserReviews", fields: [userId], references: [id], onDelete: Cascade)
  venue   Venue   @relation(fields: [venueId], references: [id], onDelete: Cascade)
  booking Booking @relation(fields: [bookingId], references: [id], onDelete: Cascade)

  @@map("reviews")
}

model VenueManagerRequest {
  id            String    @id @default(uuid())
  userId        String    @map("user_id")
  status        String    @default("PENDING") // PENDING, APPROVED, REJECTED
  businessName  String?   @map("business_name")
  businessPhone String?   @map("business_phone")
  note          String?
  reviewedBy    String?   @map("reviewed_by")
  reviewedAt    DateTime? @map("reviewed_at")
  createdAt     DateTime  @default(now()) @map("created_at")
  updatedAt     DateTime  @updatedAt @map("updated_at")

  user     User  @relation("UserRequests", fields: [userId], references: [id], onDelete: Cascade)
  reviewer User? @relation("ReviewedRequests", fields: [reviewedBy], references: [id], onDelete: SetNull)

  @@map("venue_manager_requests")
}

model Match {
  id          String      @id @default(uuid())
  hostId      String      @map("host_id")
  sport       SportType
  level       String // BEGINNER, INTERMEDIATE, ADVANCED
  startTime   DateTime    @map("start_time")
  location    String
  maxPlayers  Int         @map("max_players")
  status      MatchStatus @default(OPEN)
  description String?
  createdAt   DateTime    @default(now()) @map("created_at")
  updatedAt   DateTime    @updatedAt @map("updated_at")

  host    User          @relation("HostMatches", fields: [hostId], references: [id])
  players MatchPlayer[]

  @@map("matches")
}

model MatchPlayer {
  id       String   @id @default(uuid())
  matchId  String   @map("match_id")
  userId   String   @map("user_id")
  joinedAt DateTime @default(now()) @map("joined_at")

  match Match @relation(fields: [matchId], references: [id], onDelete: Cascade)
  user  User  @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([matchId, userId])
  @@map("match_players")
}
